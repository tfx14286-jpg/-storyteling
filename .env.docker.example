# Salin file ini menjadi ".env" di samping docker-compose.yml, lalu:
#   docker compose up -d --build
#
# Semua variabel di bawah sudah berisi nilai AUTH_SECRET dan ENCRYPTION_KEY
# yang telah dibuat sebelumnya. Buat ulang jika Anda mau:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Port yang diekspos di host ---
PORT=3000

# --- Secret (wajib) ---
AUTH_SECRET=942c6298780de75fe4c5e3d857e2caae4b88378414385ea0474cd7be9e4ee3c2
ENCRYPTION_KEY=756595eb1a9af999447e140b0d0b837bf925c285be70e39c06ef15b3d8fc1b91

# --- Mode AI: mock (offline) atau live ---
AI_MODE=mock

# --- Provider live opsional (biarkan kosong untuk tetap memakai mock) ---
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
TTS_PROVIDER=mock
MUSIC_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini

IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_MODEL=

OPENAI_TTS_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
